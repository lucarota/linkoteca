[Unit]
Description=Linkoteca Backend Service (Gunicorn+Uvicorn)
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/opt/linkoteca/backend
Environment="PATH=/opt/linkoteca/backend/venv/bin"
ExecStart=/opt/linkoteca/backend/venv/bin/gunicorn main:app -w 4 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:80
Restart=always

[Install]
WantedBy=multi-user.target
