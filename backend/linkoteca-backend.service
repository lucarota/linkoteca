[Unit]
Description=Linkoteca Backend Service (Gunicorn+Uvicorn)
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/opt/linkoteca/backend
Environment="PATH=/opt/linkoteca/backend/venv/bin"
ExecStart=/opt/linkoteca/backend/venv/bin/gunicorn main:app -w 4 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000
Restart=always

KillMode=control-group
TimeoutStopSec=30
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
